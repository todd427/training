{"system": "", "messages": [{"role": "user", "content": "help adding search and filters"}, {"role": "assistant", "content": "{\n  \"updates\": [\n    {\n      \"pattern\": \".*\",\n      \"multiple\": false,\n      \"replacement\": \"from django.db import models\\nfrom django.core.files import File\\nimport os\\nfrom tensorflow.keras.applications.mobilenet_v2 import preprocess_input, decode_predictions, MobileNetV2\\nfrom tensorflow.keras.preprocessing import image as keras_image\\nimport numpy as np\\nfrom django import forms\\nfrom django.shortcuts import render, get_object_or_404, redirect\\n\\n# Image model\\nclass Image(models.Model):\\n    file = models.ImageField(upload_to='images/')\\n    label = models.CharField(max_length=255, blank=True)\\n    tags = models.TextField(blank=True)\\n    created_at = models.DateTimeField(auto_now_add=True)\\n\\n# Form for editing image data\\nclass ImageForm(forms.ModelForm):\\n    class Meta:\\n        model = Image\\n        fields = ['label', 'tags']\\n\\n# Views for listing and editing images with search and filters\\ndef image_list_view(request):\\n    from classifier.models import Image\\n    query = request.GET.get('q', '')\\n    images = Image.objects.all().order_by('-created_at')\\n    if query:\\n        images = images.filter(models.Q(label__icontains=query) | models.Q(tags__icontains=query))\\n    return render(request, 'classifier/image_list.html', {'images': images, 'query': query})\\n\\ndef image_edit_view(request, pk):\\n    from classifier.models import Image\\n    image = get_object_or_404(Image, pk=pk)\\n    if request.method == 'POST':\\n        form = ImageForm(request.POST, instance=image)\\n        if form.is_valid():\\n            form.save()\\n            return redirect('image_list')\\n    else:\\n        form = ImageForm(instance=image)\\n    return render(request, 'classifier/image_edit.html', {'form': form, 'image': image})\\n\\n# Image classification\\nmodel = MobileNetV2(weights='imagenet')\\n\\ndef classify_image(img_path):\\n    img = keras_image.load_img(img_path, target_size=(224, 224))\\n    x = keras_image.img_to_array(img)\\n    x = np.expand_dims(x, axis=0)\\n    x = preprocess_input(x)\\n    preds = model.predict(x)\\n    return decode_predictions(preds, top=1)[0][0][1]  # Top label\\n\\n# Recursive image scanner\\ndef scan_and_upload_images_from_path(root_dir):\\n    from classifier.models import Image  # Adjust import as needed based on location\\n    for root, _, files in os.walk(root_dir):\\n        for filename in files:\\n            if filename.lower().endswith(('.png', '.jpg', '.jpeg', '.gif', '.bmp')):\\n                full_path = os.path.join(root, filename)\\n                relative_path = os.path.relpath(full_path, root_dir)\\n                try:\\n                    with open(full_path, 'rb') as f:\\n                        image_instance = Image()\\n                        image_instance.file.save(relative_path.replace(os.sep, '_'), File(f), save=False)\\n                        image_instance.label = classify_image(image_instance.file.path)\\n                        image_instance.save()\\n                        print(f\\\"Uploaded and classified: {relative_path} -> {image_instance.label}\\\")\\n                except Exception as e:\\n                    print(f\\\"Failed to upload {relative_path}: {e}\\\")\\n\\n# Management command\\ndef management_command_template():\\n    return '''\\nfrom django.core.management.base import BaseCommand\\nfrom classifier.utils import scan_and_upload_images_from_path\\n\\nclass Command(BaseCommand):\\n    help = 'Scan a directory recursively and upload/classify all images.'\\n\\n    def add_arguments(self, parser):\\n        parser.add_argument('directory', type=str, help='Directory path to scan.')\\n\\n    def handle(self, *args, **kwargs):\\n        directory = kwargs['directory']\\n        self.stdout.write(f\\\"Scanning directory: {directory}\\\")\\n        scan_and_upload_images_from_path(directory)\\n        self.stdout.write(self.style.SUCCESS('✅ Done scanning and uploading images.'))\\n'''\\n\\n# To use this: \\n# 1. Save the returned string into classifier/management/commands/scanimages.py\\n# 2. Run: python manage.py scanimages /path/to/your/images\"\n    }\n  ]\n}\n\n✅ Search and filter functionality has been added:\n\n- You can now filter images by label or tags using a query parameter: `?q=keyword`.\n- The `query` variable is passed to the template to prefill the search input.\n\nNext, would you like me to update the `image_list.html` template to include a search bar?"}], "tags": ["chatgpt", "v1"]}

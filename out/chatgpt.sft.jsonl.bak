{"system": "", "messages": [{"role": "user", "content": "Actually, when we hit \"Save Tags\" we should be shown the \"Download CSV?\" button. Can you do that?"}, {"role": "assistant", "content": "{\n  \"updates\": [\n    {\n      \"pattern\": \".*\",\n      \"multiple\": false,\n      \"replacement\": \"# tagger/models.py\\nfrom django.db import models\\nfrom classifier.models import Image\\n\\nclass Tag(models.Model):\\n    name = models.CharField(max_length=50, unique=True)\\n\\n    def __str__(self):\\n        return self.name\\n\\nclass ImageTag(models.Model):\\n    image = models.ForeignKey(Image, on_delete=models.CASCADE)\\n    tag = models.ForeignKey(Tag, on_delete=models.CASCADE)\\n\\n    class Meta:\\n        unique_together = ('image', 'tag')\\n\\n\\n# tagger/forms.py\\nfrom django import forms\\nfrom .models import Tag\\n\\nclass TaggingForm(forms.Form):\\n    tags = forms.CharField(label='Tags (comma-separated)', required=False)\\n\\n\\n# tagger/views.py\\nfrom django.shortcuts import render, redirect\\nfrom django.http import HttpResponse\\nfrom classifier.models import Image\\nfrom .models import Tag, ImageTag\\nfrom .forms import TaggingForm\\nimport csv\\n\\ndef tag_images_view(request):\\n    images = Image.objects.all().order_by('-created_at')\\n    show_export_button = False\\n\\n    if request.method == 'POST':\\n        for image in images:\\n            tag_input = request.POST.get(f'tags_{image.id}', '')\\n            tag_names = [tag.strip().lower() for tag in tag_input.split(',') if tag.strip()]\\n            ImageTag.objects.filter(image=image).delete()\\n            for name in tag_names:\\n                tag, _ = Tag.objects.get_or_create(name=name)\\n                ImageTag.objects.create(image=image, tag=tag)\\n        show_export_button = True\\n\\n    tag_data = {\\n        image.id: ', '.join(\\n            tag.name for tag in Tag.objects.filter(imagetag__image=image)\\n        ) for image in images\\n    }\\n\\n    all_tags = Tag.
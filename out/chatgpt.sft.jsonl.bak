\n    {\n        \"quote\": \"If you don't see the book you want on the shelf, write it.\",\n        \"author\": \"Beverly Cleary\",\n        \"url\": \"https://beverlycleary.com\",\n        \"source\": \"Cleary Interviews\"\n    },\n    {\n        \"quote\": \"Stories make us more alive, more human, more courageous, more loving.\",\n        \"author\": \"Madeleine L'Engle\",\n        \"url\": \"\",\n        \"source\": \"Walking on Water\"\n    },\n    {\n        \"quote\": \"The universe is made of stories, not atoms.\",\n        \"author\": \"Muriel Rukeyser\",\n        \"url\": \"\",\n        \"source\": \"The Speed of Darkness\"\n    },\n    {\n        \"quote\": \"You must stay drunk on writing so reality cannot destroy you.\",\n        \"author\": \"Ray Bradbury\",\n        \"url\": \"https://raybradbury.com\",\n        \"source\": \"Zen in the Art of Writing\"\n    },\n    {\n        \"quote\": \"Don't panic.\",\n        \"author\": \"Douglas Adams\",\n        \"url\": \"https://douglasadams.com\",\n        \"source\": \"The Hitchhiker's Guide to the Galaxy\"\n    },\n    {\n        \"quote\": \"Reality is frequently inaccurate.\",\n        \"author\": \"Douglas Adams\",\n        \"url\": \"https://douglasadams.com\",\n        \"source\": \"The Restaurant at the End of the Universe\"\n    },\n    {\n        \"quote\": \"There is no friend as loyal as a book.\",\n        \"author\": \"Ernest Hemingway\",\n        \"url\": \"\",\n        \"source\": \"Hemingway Letters\"\n    },\n    {\n        \"quote\": \"Fantasy is hardly an escape from reality. It's a way of understanding it.\",\n        \"author\": \"Lloyd Alexander\",\n        \"url\": \"\",\n        \"source\": \"The Horn Book\"\n    },\n    {\n        \"quote\": \"The best way to predict the future is to invent it.\",\n        \"author\": \"Alan Kay\",\n        \"url\": \"https://en.wikipedia.org/wiki/Alan_Kay\",\n        \"source\": \"Xerox PARC\"\n    },\n    {\n        \"quote\": \"Imagination will often carry us to worlds that never were. But without it we go nowhere.\",\n        \"author\": \"Carl Sagan\",\n        \"url\": \"https://carlsagan.com\",\n        \"source\": \"Cosmos\"\n    },\n    {\n        \"quote\": \"Somewhere, something incredible is waiting to be known.\",\n        \"author\": \"Carl Sagan\",\n        \"url\": \"https://carlsagan.com\",\n        \"source\": \"Cosmos\"\n    },\n    {\n        \"quote\": \"A book is a dream that you hold in your hand.\",\n        \"author\": \"Neil Gaiman\",\n        \"url\": \"https://neilgaiman.com\",\n        \"source\": \"Gaiman Talks\"\n    },\n    {\n        \"quote\": \"Fairy tales are more than true — not because they tell us dragons exist, but because they tell us dragons can be beaten.\",\n        \"author\": \"Neil Gaiman\",\n        \"url\": \"https://neilgaiman.com\",\n        \"source\": \"Coraline\"\n    },\n    {\n        \"quote\": \"You can make anything by writing.\",\n        \"author\": \"C.S. Lewis\",\n        \"url\": \"https://cslewis.com\",\n        \"source\": \"Lewis Letters\"\n    },\n    {\n        \"quote\": \"The secret of getting ahead is getting started.\",\n        \"author\": \"Mark Twain\",\n        \"url\": \"\",\n        \"source\": \"Twain Quotations\"\n    },\n    {\n        \"quote\": \"The difference between fiction and reality? Fiction has to make sense.\",\n        \"author\": \"Tom Clancy\",\n        \"url\": \"\",\n        \"source\": \"Clancy Interviews\"\n    },\n    {\n        \"quote\": \"Words are, in my not-so-humble opinion, our most inexhaustible source of magic.\",\n        \"author\": \"J.K. Rowling\",\n        \"url\": \"https://jkrowling.com\",\n        \"source\": \"Harry Potter and the Deathly Hallows\"\n    },\n    {\n        \"quote\": \"Reading is essential for those who seek to rise above the ordinary.\",\n        \"author\": \"Jim Rohn\",\n        \"url\": \"\",\n        \"source\": \"Rohn Talks\"\n    },\n    {\n        \"quote\": \"A room without books is like a body without a soul.\",\n        \"author\": \"Marcus Tullius Cicero\",\n        \"url\": \"\",\n        \"source\": \"Cicero Letters\"\n    },\n    {\n        \"quote\": \"It is never too late to be what you might have been.\",\n        \"author\": \"George Eliot\",\n        \"url\": \"\",\n        \"source\": \"Eliot Works\"\n    },\n    {\n        \"quote\": \"We are what we repeatedly do. Excellence, then, is not an act but a habit.\",\n        \"author\": \"Aristotle\",\n        \"url\": \"\",\n        \"source\": \"Aristotle Works\"\n    },\n    {\n        \"quote\": \"You miss 100% of the shots you don’t take.\",\n        \"author\": \"Wayne Gretzky\",\n        \"url\": \"\",\n        \"source\": \"Gretzky Talks\"\n    },\n    {\n        \"quote\": \"If you want to fly, you have to give up the things that weigh you down.\",\n        \"author\": \"Toni Morrison\",\n        \"url\": \"https://tonimorrison.com\",\n        \"source\": \"Morrison Works\"\n    },\n    {\n        \"quote\": \"We are all stories in the end. Just make it a good one.\",\n        \"author\": \"Doctor Who\",\n        \"url\": \"https://bbc.co.uk/doctorwho\",\n        \"source\": \"Doctor Who\"\n    },\n    {\n        \"quote\": \"Don't tell me the moon is shining; show me the glint of light on broken glass.\",\n        \"author\": \"Anton Chekhov\",\n        \"url\": \"\",\n        \"source\": \"Chekhov Letters\"\n    },\n    {\n        \"quote\": \"The only thing you absolutely have to know is the location of the library.\",\n        \"author\": \"Albert Einstein\",\n        \"url\": \"https://einstein-archives.org\",\n        \"source\": \"Attributed\"\n    },\n    {\n        \"quote\": \"Logic will get you from A to B. Imagination will take you everywhere.\",\n        \"author\": \"Albert Einstein\",\n        \"url\": \"https://einstein-archives.org\",\n        \"source\": \"Attributed\"\n    },\n    {\n        \"quote\": \"Fill your paper with the breathings of 
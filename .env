# model
#MODEL_ID=toddie314/toddric-zephyr7b
#MODEL_ID=toddie314/toddric-3b-merged-v3
#MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# or: MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
#MODEL_ID=mistralai/Mistral-7B-v0.1

TRAIN_JSONL=./data/sft_ready/train.jsonl
VAL_JSONL=./data/sft_ready/val.jsonl
OUT_DIR=./ckpts/toddric-llama-8B-lora
SEQ_LEN=2048
LORA_R=32
LORA_ALPHA=64
LORA_DROPOUT=0.05
EPOCHS=2
MBATCH=1
ACCUM=16
EVAL_STEPS=250
SAVE_STEPS=500
NO_4BIT=0
NUM_WORKERS=0

#transcripts
LOG_TRANSCRIPTS=1
LOG_DIR=./logs
LOG_ROTATE_MB=50

# auth
ALLOW_NO_AUTH=1   # for local dev; unset in prod
# TODDRIC_BEARER=supersecret


# quant / device
LOAD_IN_4BIT=1
DEVICE_MAP=auto
TORCH_DTYPE=auto
TORCH_DEVICE=auto

# decoding defaults (tight + helpful)
DO_SAMPLE=1
TEMPERATURE=0.3
TOP_P=0.9
MAX_NEW_TOKENS=256
REPETITION_PENALTY=1.12

# perf
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

